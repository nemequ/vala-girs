      <method name="close" c:identifier="dex_generator_close" version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-generator.c"
             line="425">Requests shutdown without blocking. Ordinary item futures remain independent.
Adapter cancellation is cooperative; producers must honor failed yields and
awaits. Cleanup runs on the adapter scheduler, or on the thread closing an
ordinary generator (the callback thread if a callback is still active).</doc>
        <source-position filename="src/dex-generator.h" line="149"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/dex-generator.c"
                 line="427">a generator</doc>
            <type name="Generator" c:type="DexGenerator*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="close_after_drain"
              c:identifier="dex_generator_close_after_drain"
              version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-generator.c"
             line="458">Closes and waits for callback data destruction. Repeated calls share a result.
