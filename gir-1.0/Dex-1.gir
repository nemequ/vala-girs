           glib:fundamental="1">
      <doc xml:space="preserve"
           filename="src/dex-generator.c"
           line="80">A pull-driven sequence of futures. Ordinary generators transfer each future
directly to the caller without observing it. Sequential consumers finish each
pull before requesting another and check exhaustion after awaiting the pull.</doc>
      <constructor name="new" c:identifier="dex_generator_new" version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-generator.c"
             line="268">Creates a generator whose factory runs directly in the calling context.
Returned futures must independently retain any state they need. The factory
data is retained until close or finalization, including after exhaustion.</doc>
        <source-position filename="src/dex-generator.h" line="167"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
