      <constructor name="new_coroutine"
                   c:identifier="dex_generator_new_coroutine"
                   version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-generator.c"
             line="736">Creates a lazy coroutine producer with the same demand protocol as a fiber
generator. State surviving suspension belongs in @user_data. Cancellation
retains data until pending work completes. If no thread scheduler exists,
the process default is captured.</doc>
