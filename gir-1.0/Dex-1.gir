    <class name="Deferred"
           c:symbol-prefix="deferred"
           c:type="DexDeferred"
           version="1.3"
           parent="Future"
           final="1"
           glib:type-name="DexDeferred"
           glib:get-type="dex_deferred_get_type"
           glib:fundamental="1">
      <doc xml:space="preserve"
           filename="src/dex-deferred.c"
           line="65">A future whose work starts when another future observes it, such as through
[ctor@Dex.Future.then] or [method@Dex.Future.await]. Its work starts once.
Querying its status or value does not start the work.
Dropping it without observing it releases its callback data without
invoking the callback. Scheduler-backed deferreds queue data destruction on
their captured scheduler, including when never observed. Native thread-pool
deferreds capture their cleanup scheduler at construction too.
If its last observer is discarded before the work starts, the deferred
rejects with %G_IO_ERROR_CANCELLED. Work that has already started may
still run while cancellation propagates.</doc>
      <constructor name="new" c:identifier="dex_deferred_new" version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-deferred.c"
             line="206">Creates deferred work that calls @func on @scheduler. The returned future
completes with the result of the future returned by @func.

If @scheduler is %NULL and the current thread has no scheduler, the process
default scheduler is captured instead.</doc>
        <source-position filename="src/dex-deferred.h" line="56"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/dex-deferred.c"
               line="219">a new deferred</doc>
          <type name="Deferred" c:type="DexDeferred*"/>
        </return-value>
        <parameters>
          <parameter name="scheduler"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="src/dex-deferred.c"
                 line="208">scheduler for @func, or %NULL to capture the thread's scheduler</doc>
            <type name="Scheduler" c:type="DexScheduler*"/>
          </parameter>
          <parameter name="func"
