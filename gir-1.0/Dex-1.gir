    <function-macro name="DEFINE_CLOSURE_TYPE"
                    c:identifier="DEX_DEFINE_CLOSURE_TYPE"
                    version="1.2"
                    introspectable="0">
      <doc xml:space="preserve"
           filename="src/dex-closure.h"
           line="81">This macro is a lightweight helper for quickly defining closure-like state
structs with matching `type_prefix_new()` and `type_prefix_free()` helpers.

It is intentionally generic; while coroutine task states are a common use case,
the generated type is also useful for quick one-off task/closure structs.

Example:
```c
DEX_DEFINE_CLOSURE_TYPE (MyTaskState, my_task_state,
                         DEX_DEFINE_CLOSURE_VALUE (gsize, bytes),
                         DEX_DEFINE_CLOSURE_POINTER (GBytes *, bytes_obj, g_bytes_unref),
                         DEX_DEFINE_CLOSURE_OBJECT (GSocketConnection, conn))
```</doc>
      <source-position filename="src/dex-closure.h" line="103"/>
      <parameters>
        <parameter name="type_name">
          <doc xml:space="preserve"
               filename="src/dex-closure.h"
               line="83">generated struct name</doc>
        </parameter>
        <parameter name="type_prefix">
          <doc xml:space="preserve"
               filename="src/dex-closure.h"
               line="84">function prefix for generated helpers</doc>
        </parameter>
        <parameter name="...">
          <doc xml:space="preserve"
               filename="src/dex-closure.h"
               line="85">one or more `DEX_DEFINE_CLOSURE_*()` field descriptors</doc>
        </parameter>
      </parameters>
    </function-macro>
