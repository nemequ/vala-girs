      <function name="zipv" c:identifier="dex_generator_zipv" version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-generator-functional.c"
             line="108">Zips sources lazily, pulling left to right, one at a time. Like Python's
`zip()`, it stops at the shortest input. An earlier input can advance once
before a later input reports exhaustion. The sources are closed when the
result ends, fails, or closes. The result takes a reference to each source.
Zero inputs produce an empty generator.</doc>
        <source-position filename="src/dex-generator.h" line="190"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/dex-generator-functional.c"
               line="119">a generator of [struct@Dex.Tuple] values</doc>
          <type name="Generator" c:type="DexGenerator*"/>
        </return-value>
        <parameters>
          <parameter name="generators"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="src/dex-generator-functional.c"
                 line="110">sources</doc>
            <array length="1"
                   zero-terminated="0"
                   c:type="DexGenerator* const*">
              <type name="Generator"/>
            </array>
          </parameter>
          <parameter name="n_generators" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/dex-generator-functional.c"
                 line="111">number of sources</doc>
            <type name="guint" c:type="guint"/>
          </parameter>
        </parameters>
      </function>
      <method name="await_next"
              c:identifier="dex_generator_await_next"
              version="1.3"
              throws="1">
        <doc xml:space="preserve"
             filename="src/dex-generator.c"
             line="501">Consumes one sequential pull. Rejection is checked before exhaustion. On
success, unset @value after use. On exhaustion or error it stays uninitialized.
