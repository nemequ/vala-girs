      <constructor name="new_for_channel"
                   c:identifier="dex_generator_new_for_channel"
                   version="1.3">
        <doc xml:space="preserve"
             filename="src/dex-generator.c"
             line="828">Creates a generator which yields values received from @channel. When
@completion finishes, the send side closes. Buffered values are yielded
before the completion result determines exhaustion or failure. Closing the
generator closes the receive side and discards @completion.</doc>
        <source-position filename="src/dex-generator.h" line="176"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/dex-generator.c"
               line="838">a generator</doc>
          <type name="Generator" c:type="DexGenerator*"/>
